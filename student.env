STUDENT_CLASS="K24 CNTT1"
STUDENT_EMAIL="nguyenvantoan200608@gmail.com"
GITHUB_USERNAME="nguyenvantoan-code"

# ---------- 2. Thông số triển khai trên server chung ----------
# Mã đề (KHÔNG sửa)
EXAM_CODE="003"
# Cổng cá nhân trên server chung: từ 8080 trở lên, KHÔNG trùng với bạn khác
APP_PORT="8096"
# Tên project Docker Compose: <tên-viết-tắt>-de003, viết thường, ví dụ: nguyenvana-de003
COMPOSE_PROJECT_NAME="nguyenvantoan-de003"

# ---------- 3. Cơ sở dữ liệu MySQL ----------
# Tên database (KHÔNG sửa)
